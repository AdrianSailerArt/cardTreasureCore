{
  "name": "@cardtreasure/core",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "description": "Gemeinsamer Code für CardTreasure Shop und CMS: Fachmodule (Versand, Bilder) und ein Nuxt-Layer mit gemeinsamen UI-Bausteinen.",
  "exports": {
    "./shipping": {
      "types": "./dist/shipping.d.ts",
      "default": "./dist/shipping.js"
    },
    "./slug": {
      "types": "./dist/slug.d.ts",
      "default": "./dist/slug.js"
    },
    "./lan": {
      "types": "./dist/lan.d.ts",
      "default": "./dist/lan.js"
    },
    "./dev-origins": {
      "types": "./dist/dev-origins.d.ts",
      "default": "./dist/dev-origins.js"
    },
    "./media": {
      "types": "./dist/media.d.ts",
      "default": "./dist/media.js"
    },
    "./images": {
      "types": "./dist/images.d.ts",
      "default": "./dist/images.js"
    },
    "./nuxt": "./nuxt/nuxt.config.ts",
    "./nuxt/assets/*": "./nuxt/assets/*",
    "./nuxt/components/*": "./nuxt/components/*",
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "default": "./dist/status.js"
    },
    "./mailer": {
      "types": "./dist/mailer.d.ts",
      "default": "./dist/mailer.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "default": "./dist/db.js"
    },
    "./test-accounts": {
      "types": "./dist/test-accounts.d.ts",
      "default": "./dist/test-accounts.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./dev-server": {
      "types": "./dist/dev-server.d.ts",
      "default": "./dist/dev-server.js"
    }
  },
  "files": [
    "dist",
    "nuxt"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "release": "bun run build && bun test"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45",
    "vue": ">=3.5",
    "nuxt": ">=4",
    "sharp": ">=0.34",
    "aws4fetch": ">=1.0",
    "vue-echarts": "*",
    "echarts": "*",
    "nodemailer": "*",
    "zod": ">=4",
    "h3": "*"
  },
  "peerDependenciesMeta": {
    "nuxt": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "zod": {
      "optional": true
    },
    "h3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.4",
    "nodemailer": "^10.4.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.0"
  }
}
